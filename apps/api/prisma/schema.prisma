generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  LANDLORD
  STAFF
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING
}

enum PropertyStatus {
  ACTIVE
  ARCHIVED
  INACTIVE
}

enum UnitStatus {
  VACANT
  OCCUPIED
  RESERVED
  UNDER_MAINTENANCE
  INACTIVE
}

enum FloorStatus {
  ACTIVE
  ARCHIVED
  INACTIVE
}

enum TenantStatus {
  ACTIVE
  PENDING
  MOVED_OUT
  SUSPENDED
  ARCHIVED
}

enum UtilityBillingMethod {
  METERED
  FIXED_MONTHLY
  INCLUDED_IN_RENT
  MANUAL_AMOUNT
  SHARED_EQUALLY
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
  PENDING
}

enum BillingStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum BillingLineItemType {
  RENT
  ELECTRICITY
  WATER
  PREVIOUS_BALANCE
  PENALTY
  OTHER_CHARGE
  DISCOUNT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  GCASH
  MAYA
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REVERSED
  CANCELLED
}

enum NotificationType {
  RENT_DUE
  OVERDUE_RENT
  UNPAID_UTILITY
  CONTRACT_EXPIRATION
  SUBSCRIPTION_EXPIRATION
  PROPERTY_LIMIT_REACHED
  NEW_PAYMENT
  METER_READING_MISSING
  UNIT_BECOMING_VACANT
}

enum AuditAction {
  LOGIN
  FAILED_LOGIN
  LANDLORD_CREATION
  ACCOUNT_SUSPENSION
  PROPERTY_CREATION
  UNIT_MODIFICATION
  TENANT_ASSIGNMENT
  BILLING_GENERATION
  METER_READING_CORRECTION
  PAYMENT_RECORDING
  PAYMENT_REVERSAL
  THEME_CHANGE
  SUBSCRIPTION_CHANGE
  SYSTEM_SETTING_CHANGE
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  email               String           @unique
  passwordHash        String
  fullName            String
  role                UserRole
  status              AccountStatus    @default(ACTIVE)
  landlordId          String?          @db.Uuid
  landlord            LandlordProfile? @relation(fields: [landlordId], references: [id])
  lastLoginAt         DateTime?
  refreshTokenVersion Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdBy           String?          @db.Uuid
  updatedBy           String?          @db.Uuid
  archivedAt          DateTime?

  auditLogs       AuditLog[]
  notifications   Notification[]
  uploadedFiles   UploadedFile[]
  createdPayments Payment[]    @relation("PaymentReceiver")

  @@index([landlordId])
  @@index([role, status])
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LandlordProfile {
  id                   String              @id @default(uuid()) @db.Uuid
  fullName             String
  businessName         String
  email                String              @unique
  contactNumber        String?
  address              String?
  status               AccountStatus       @default(ACTIVE)
  maxProperties        Int                 @default(1)
  subscriptionPlanId   String?             @db.Uuid
  subscriptionPlan     SubscriptionPlan?   @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionStartAt  DateTime?
  subscriptionExpiresAt DateTime?
  logoFileId           String?             @db.Uuid
  notes                String?
  lastLoginAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy            String?             @db.Uuid
  updatedBy            String?             @db.Uuid
  archivedAt           DateTime?

  users             User[]
  subscriptions     LandlordSubscription[]
  properties        Property[]
  floors            Floor[]
  units             Unit[]
  tenants           Tenant[]
  tenantAssignments TenantUnitAssignment[]
  leases            Lease[]
  billings          BillingStatement[]
  billingLineItems  BillingLineItem[]
  payments          Payment[]
  paymentAllocations PaymentAllocation[]
  paymentReversals PaymentReversal[]
  otherCharges      OtherCharge[]
  discounts         Discount[]
  penalties         Penalty[]
  themeSetting      ThemeSetting?
  notifications     Notification[]
  auditLogs         AuditLog[]
  uploadedFiles     UploadedFile[]
  electricityReadings ElectricityReading[]
  waterReadings     WaterReading[]

  @@index([status])
}

model SubscriptionPlan {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @unique
  description    String?
  monthlyPrice   Decimal           @default(0) @db.Decimal(12, 2)
  maxProperties  Int
  features       Json?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  landlords      LandlordProfile[]
  subscriptions  LandlordSubscription[]
}

model LandlordSubscription {
  id          String           @id @default(uuid()) @db.Uuid
  landlordId  String           @db.Uuid
  planId      String           @db.Uuid
  startsAt    DateTime
  expiresAt   DateTime
  status      AccountStatus    @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?          @db.Uuid
  updatedBy   String?          @db.Uuid
  archivedAt  DateTime?

  landlord    LandlordProfile  @relation(fields: [landlordId], references: [id])
  plan        SubscriptionPlan  @relation(fields: [planId], references: [id])

  @@index([landlordId, status])
  @@index([expiresAt])
}

model Property {
  id                  String         @id @default(uuid()) @db.Uuid
  landlordId          String         @db.Uuid
  name                String
  code                String
  description         String?
  address             String
  contactNumber       String?
  imageFileId         String?        @db.Uuid
  numberOfFloors      Int            @default(1)
  totalUnits          Int            @default(0)
  propertyManagerName String?
  status              PropertyStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String?        @db.Uuid
  updatedBy           String?        @db.Uuid
  archivedAt          DateTime?

  landlord            LandlordProfile @relation(fields: [landlordId], references: [id])
  units               Unit[]
  floors              Floor[]
  tenants             Tenant[]
  tenantAssignments   TenantUnitAssignment[]
  leases              Lease[]
  billings            BillingStatement[]
  payments            Payment[]
  electricityReadings ElectricityReading[]
  waterReadings       WaterReading[]
  otherCharges        OtherCharge[]
  discounts           Discount[]
  penalties           Penalty[]

  @@unique([landlordId, code])
  @@index([landlordId, status])
}

model Floor {
  id           String      @id @default(uuid()) @db.Uuid
  landlordId   String      @db.Uuid
  propertyId   String      @db.Uuid
  name         String
  floorNumber  Int
  displayOrder Int
  description  String?
  status       FloorStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdBy    String?     @db.Uuid
  updatedBy    String?     @db.Uuid
  archivedAt   DateTime?

  landlord     LandlordProfile @relation(fields: [landlordId], references: [id])
  property     Property        @relation(fields: [propertyId], references: [id])
  units        Unit[]

  @@unique([propertyId, floorNumber])
  @@unique([propertyId, displayOrder])
  @@index([landlordId, propertyId, status])
}

model Unit {
  id                       String               @id @default(uuid()) @db.Uuid
  landlordId               String               @db.Uuid
  propertyId               String               @db.Uuid
  floorId                  String?              @db.Uuid
  unitNumber               String
  unitName                 String?
  floorLabel               String?
  unitType                 String?
  description              String?
  monthlyRent              Decimal              @db.Decimal(12, 2)
  securityDeposit          Decimal              @default(0) @db.Decimal(12, 2)
  maxOccupants             Int                  @default(1)
  currentOccupantCount     Int                  @default(0)
  electricityBillingMethod UtilityBillingMethod @default(METERED)
  waterBillingMethod       UtilityBillingMethod @default(METERED)
  status                   UnitStatus           @default(VACANT)
  notes                    String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  createdBy                String?              @db.Uuid
  updatedBy                String?              @db.Uuid
  archivedAt               DateTime?

  landlord                 LandlordProfile      @relation(fields: [landlordId], references: [id])
  property                 Property             @relation(fields: [propertyId], references: [id])
  floor                    Floor?               @relation(fields: [floorId], references: [id])
  assignments              TenantUnitAssignment[]
  tenants                  Tenant[]
  leases                   Lease[]
  billings                 BillingStatement[]
  payments                 Payment[]
  electricityReadings      ElectricityReading[]
  waterReadings            WaterReading[]

  @@unique([propertyId, unitNumber])
  @@index([landlordId, status])
  @@index([propertyId, status])
  @@index([floorId, status])
}

model Tenant {
  id                     String       @id @default(uuid()) @db.Uuid
  landlordId             String       @db.Uuid
  propertyId             String?      @db.Uuid
  unitId                 String?      @db.Uuid
  fullName               String
  profilePhotoFileId     String?      @db.Uuid
  email                  String?
  contactNumber          String?
  permanentAddress       String?
  emergencyContactName   String?
  emergencyContactNumber String?
  validIdType            String?
  validIdNumber          String?
  idImageFileId          String?      @db.Uuid
  monthlyRent            Decimal      @default(0) @db.Decimal(12, 2)
  securityDeposit        Decimal      @default(0) @db.Decimal(12, 2)
  moveInDate             DateTime?
  contractStartDate      DateTime?
  contractEndDate        DateTime?
  billingDueDay          Int          @default(1)
  status                 TenantStatus @default(PENDING)
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  createdBy              String?      @db.Uuid
  updatedBy              String?      @db.Uuid
  archivedAt             DateTime?

  landlord               LandlordProfile @relation(fields: [landlordId], references: [id])
  property               Property?       @relation(fields: [propertyId], references: [id])
  unit                   Unit?           @relation(fields: [unitId], references: [id])
  assignments            TenantUnitAssignment[]
  leases                 Lease[]
  billings               BillingStatement[]
  payments               Payment[]
  electricityReadings    ElectricityReading[]
  waterReadings          WaterReading[]

  @@index([landlordId, status])
  @@index([propertyId])
  @@index([unitId])
}

model TenantUnitAssignment {
  id          String       @id @default(uuid()) @db.Uuid
  landlordId  String       @db.Uuid
  tenantId    String       @db.Uuid
  propertyId  String       @db.Uuid
  unitId      String       @db.Uuid
  moveInDate  DateTime
  moveOutDate DateTime?
  status      LeaseStatus  @default(ACTIVE)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?

  landlord    LandlordProfile @relation(fields: [landlordId], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  property    Property        @relation(fields: [propertyId], references: [id])
  unit        Unit            @relation(fields: [unitId], references: [id])

  @@index([landlordId, status])
  @@index([tenantId, status])
  @@index([unitId, status])
}

model Lease {
  id               String       @id @default(uuid()) @db.Uuid
  landlordId       String       @db.Uuid
  tenantId         String       @db.Uuid
  propertyId       String       @db.Uuid
  unitId           String       @db.Uuid
  monthlyRent      Decimal      @db.Decimal(12, 2)
  securityDeposit  Decimal      @default(0) @db.Decimal(12, 2)
  startsAt         DateTime
  endsAt           DateTime?
  billingDueDay    Int          @default(1)
  status           LeaseStatus  @default(ACTIVE)
  terms            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?      @db.Uuid
  updatedBy        String?      @db.Uuid
  archivedAt       DateTime?

  landlord         LandlordProfile @relation(fields: [landlordId], references: [id])
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  property         Property        @relation(fields: [propertyId], references: [id])
  unit             Unit            @relation(fields: [unitId], references: [id])
  billings         BillingStatement[]

  @@index([landlordId, status])
  @@index([tenantId, status])
  @@index([unitId, status])
}

model BillingStatement {
  id                    String        @id @default(uuid()) @db.Uuid
  landlordId            String        @db.Uuid
  tenantId              String        @db.Uuid
  propertyId            String        @db.Uuid
  unitId                String        @db.Uuid
  leaseId               String?       @db.Uuid
  billingPeriod         DateTime
  monthlyRent           Decimal       @default(0) @db.Decimal(12, 2)
  electricityCharge     Decimal       @default(0) @db.Decimal(12, 2)
  waterCharge           Decimal       @default(0) @db.Decimal(12, 2)
  previousBalance       Decimal       @default(0) @db.Decimal(12, 2)
  penaltyAmount         Decimal       @default(0) @db.Decimal(12, 2)
  otherChargesAmount    Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal       @default(0) @db.Decimal(12, 2)
  totalAmountDue        Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid            Decimal       @default(0) @db.Decimal(12, 2)
  remainingBalance      Decimal       @default(0) @db.Decimal(12, 2)
  dueDate               DateTime
  finalizedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  status                BillingStatus @default(DRAFT)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  createdBy             String?       @db.Uuid
  updatedBy             String?       @db.Uuid
  archivedAt            DateTime?

  landlord              LandlordProfile @relation(fields: [landlordId], references: [id])
  tenant                Tenant          @relation(fields: [tenantId], references: [id])
  property              Property        @relation(fields: [propertyId], references: [id])
  unit                  Unit            @relation(fields: [unitId], references: [id])
  lease                 Lease?          @relation(fields: [leaseId], references: [id])
  lineItems             BillingLineItem[]
  paymentAllocations    PaymentAllocation[]
  otherCharges          OtherCharge[]
  discounts             Discount[]
  penalties             Penalty[]

  @@unique([tenantId, billingPeriod])
  @@index([landlordId, status])
  @@index([propertyId, billingPeriod])
}

model BillingLineItem {
  id                 String              @id @default(uuid()) @db.Uuid
  landlordId         String              @db.Uuid
  billingStatementId String              @db.Uuid
  type               BillingLineItemType
  description        String
  amount             Decimal             @db.Decimal(12, 2)
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          String?             @db.Uuid
  updatedBy          String?             @db.Uuid
  archivedAt         DateTime?

  landlord           LandlordProfile     @relation(fields: [landlordId], references: [id])
  billingStatement   BillingStatement    @relation(fields: [billingStatementId], references: [id])

  @@index([landlordId])
  @@index([billingStatementId])
}

model ElectricityReading {
  id               String   @id @default(uuid()) @db.Uuid
  landlordId       String   @db.Uuid
  propertyId       String   @db.Uuid
  unitId           String   @db.Uuid
  tenantId         String?  @db.Uuid
  billingMonth     DateTime
  previousReading  Decimal  @default(0) @db.Decimal(12, 3)
  currentReading   Decimal  @default(0) @db.Decimal(12, 3)
  consumption      Decimal  @default(0) @db.Decimal(12, 3)
  ratePerUnit      Decimal  @default(0) @db.Decimal(12, 4)
  fixedCharge      Decimal  @default(0) @db.Decimal(12, 2)
  amount           Decimal  @default(0) @db.Decimal(12, 2)
  readingDate      DateTime
  meterPhotoFileId String?  @db.Uuid
  notes            String?
  recordedById     String?  @db.Uuid
  correctionReason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?  @db.Uuid
  updatedBy        String?  @db.Uuid
  archivedAt       DateTime?

  landlord         LandlordProfile @relation(fields: [landlordId], references: [id])
  property         Property        @relation(fields: [propertyId], references: [id])
  unit             Unit            @relation(fields: [unitId], references: [id])
  tenant           Tenant?         @relation(fields: [tenantId], references: [id])

  @@unique([unitId, billingMonth])
  @@index([landlordId, billingMonth])
}

model WaterReading {
  id               String   @id @default(uuid()) @db.Uuid
  landlordId       String   @db.Uuid
  propertyId       String   @db.Uuid
  unitId           String?  @db.Uuid
  tenantId         String?  @db.Uuid
  billingMonth     DateTime
  previousReading  Decimal  @default(0) @db.Decimal(12, 3)
  currentReading   Decimal  @default(0) @db.Decimal(12, 3)
  consumption      Decimal  @default(0) @db.Decimal(12, 3)
  ratePerUnit      Decimal  @default(0) @db.Decimal(12, 4)
  fixedCharge      Decimal  @default(0) @db.Decimal(12, 2)
  totalPropertyBill Decimal @default(0) @db.Decimal(12, 2)
  occupiedUnitCount Int?
  amount           Decimal  @default(0) @db.Decimal(12, 2)
  calculationNote  String?
  readingDate      DateTime
  meterPhotoFileId String?  @db.Uuid
  notes            String?
  recordedById     String?  @db.Uuid
  correctionReason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?  @db.Uuid
  updatedBy        String?  @db.Uuid
  archivedAt       DateTime?

  landlord         LandlordProfile @relation(fields: [landlordId], references: [id])
  property         Property        @relation(fields: [propertyId], references: [id])
  unit             Unit?           @relation(fields: [unitId], references: [id])
  tenant           Tenant?         @relation(fields: [tenantId], references: [id])

  @@unique([unitId, billingMonth])
  @@index([landlordId, billingMonth])
  @@index([propertyId, billingMonth])
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  landlordId         String        @db.Uuid
  tenantId           String        @db.Uuid
  propertyId         String        @db.Uuid
  unitId             String        @db.Uuid
  officialReceiptNo  String
  paymentDate        DateTime
  amountPaid         Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod
  referenceNumber    String?
  receivedById       String?       @db.Uuid
  notes              String?
  proofFileId        String?       @db.Uuid
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdBy          String?       @db.Uuid
  updatedBy          String?       @db.Uuid
  archivedAt         DateTime?

  landlord           LandlordProfile @relation(fields: [landlordId], references: [id])
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  property           Property        @relation(fields: [propertyId], references: [id])
  unit               Unit            @relation(fields: [unitId], references: [id])
  receivedBy         User?           @relation("PaymentReceiver", fields: [receivedById], references: [id])
  allocations        PaymentAllocation[]
  reversal           PaymentReversal?

  @@unique([landlordId, officialReceiptNo])
  @@index([landlordId, status])
  @@index([tenantId, paymentDate])
}

model PaymentAllocation {
  id                 String           @id @default(uuid()) @db.Uuid
  landlordId         String           @db.Uuid
  paymentId          String           @db.Uuid
  billingStatementId String           @db.Uuid
  amount             Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdBy          String?          @db.Uuid
  updatedBy          String?          @db.Uuid
  archivedAt         DateTime?

  landlord           LandlordProfile  @relation(fields: [landlordId], references: [id])
  payment            Payment          @relation(fields: [paymentId], references: [id])
  billingStatement   BillingStatement @relation(fields: [billingStatementId], references: [id])

  @@index([landlordId])
  @@index([paymentId])
  @@index([billingStatementId])
}

model PaymentReversal {
  id          String   @id @default(uuid()) @db.Uuid
  landlordId  String   @db.Uuid
  paymentId   String   @unique @db.Uuid
  reason      String
  reversedAt  DateTime @default(now())
  reversedBy  String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  @db.Uuid
  updatedBy   String?  @db.Uuid
  archivedAt  DateTime?

  landlord    LandlordProfile @relation(fields: [landlordId], references: [id])
  payment     Payment         @relation(fields: [paymentId], references: [id])

  @@index([landlordId, reversedAt])
}

model OtherCharge {
  id                 String            @id @default(uuid()) @db.Uuid
  landlordId         String            @db.Uuid
  propertyId         String?           @db.Uuid
  billingStatementId String?           @db.Uuid
  description        String
  amount             Decimal           @db.Decimal(12, 2)
  reason             String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?           @db.Uuid
  updatedBy          String?           @db.Uuid
  archivedAt         DateTime?

  landlord           LandlordProfile   @relation(fields: [landlordId], references: [id])
  property           Property?         @relation(fields: [propertyId], references: [id])
  billingStatement   BillingStatement? @relation(fields: [billingStatementId], references: [id])

  @@index([landlordId])
}

model Discount {
  id                 String            @id @default(uuid()) @db.Uuid
  landlordId         String            @db.Uuid
  propertyId         String?           @db.Uuid
  billingStatementId String?           @db.Uuid
  description        String
  amount             Decimal           @db.Decimal(12, 2)
  reason             String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?           @db.Uuid
  updatedBy          String?           @db.Uuid
  archivedAt         DateTime?

  landlord           LandlordProfile   @relation(fields: [landlordId], references: [id])
  property           Property?         @relation(fields: [propertyId], references: [id])
  billingStatement   BillingStatement? @relation(fields: [billingStatementId], references: [id])

  @@index([landlordId])
}

model Penalty {
  id                 String            @id @default(uuid()) @db.Uuid
  landlordId         String            @db.Uuid
  propertyId         String?           @db.Uuid
  billingStatementId String?           @db.Uuid
  description        String
  amount             Decimal           @db.Decimal(12, 2)
  reason             String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?           @db.Uuid
  updatedBy          String?           @db.Uuid
  archivedAt         DateTime?

  landlord           LandlordProfile   @relation(fields: [landlordId], references: [id])
  property           Property?         @relation(fields: [propertyId], references: [id])
  billingStatement   BillingStatement? @relation(fields: [billingStatementId], references: [id])

  @@index([landlordId])
}

model ThemeSetting {
  id                      String   @id @default(uuid()) @db.Uuid
  landlordId              String   @unique @db.Uuid
  presetName              String?
  primaryColor            String
  secondaryColor          String
  accentColor             String
  sidebarColor            String
  headerColor             String
  backgroundColor         String
  textColor               String
  buttonStyle             String
  borderRadius            String
  colorMode               String   @default("light")
  logoFileId              String?  @db.Uuid
  businessName            String?
  faviconFileId           String?  @db.Uuid
  receiptHeader           String?
  billingStatementHeader  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdBy               String?  @db.Uuid
  updatedBy               String?  @db.Uuid
  archivedAt              DateTime?

  landlord                LandlordProfile @relation(fields: [landlordId], references: [id])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  landlordId  String?          @db.Uuid
  userId      String?          @db.Uuid
  type        NotificationType
  title       String
  message     String
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?          @db.Uuid
  updatedBy   String?          @db.Uuid
  archivedAt  DateTime?

  landlord    LandlordProfile? @relation(fields: [landlordId], references: [id])
  user        User?            @relation(fields: [userId], references: [id])

  @@index([landlordId, readAt])
  @@index([userId, readAt])
}

model AuditLog {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String?      @db.Uuid
  role        UserRole?
  landlordId  String?      @db.Uuid
  action      AuditAction
  module      String
  recordId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())

  user        User?        @relation(fields: [userId], references: [id])
  landlord    LandlordProfile? @relation(fields: [landlordId], references: [id])

  @@index([landlordId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  @db.Uuid
  updatedBy   String?  @db.Uuid
  archivedAt  DateTime?
}

model UploadedFile {
  id           String   @id @default(uuid()) @db.Uuid
  landlordId   String?  @db.Uuid
  uploadedById String?  @db.Uuid
  originalName String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  checksum     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  @db.Uuid
  updatedBy    String?  @db.Uuid
  archivedAt   DateTime?

  landlord     LandlordProfile? @relation(fields: [landlordId], references: [id])
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id])

  @@index([landlordId])
  @@index([uploadedById])
}

PORT=4000
CORS_ORIGINS=http://localhost:5173

# Use "memory" for the built-in demo seed or "firestore" for Firebase.
BH_DATA_SOURCE=memory
FIRESTORE_WRITE_THROUGH=false

FIREBASE_PROJECT_ID=boarding-housems
FIREBASE_STORAGE_BUCKET=boarding-housems.firebasestorage.app

# Prefer one of these Firebase Admin credential options for server-side Firestore.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"boarding-housems",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\absolute\path\to\serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\service-account.json
